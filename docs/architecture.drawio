<mxCell id="rules" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#202124&quot;&gt;Rule 1 — UI and Redux never import mqtt or fetch; only adapters know protocols.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#202124&quot;&gt;Rule 2 — A new protocol = 1 adapter class + 1 registry entry; no screen changes.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontSize=13;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="720.0" y="822.0" width="840.0" height="44.0" as="geometry"/></mxCell>
