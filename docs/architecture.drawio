<mxCell id="cmd1" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#1a73e8&quot;&gt;&lt;b&gt;2  State (Redux)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;dispatch(sendCommand(id,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;cmd)) thunk runs&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=2;fontColor=#202124;fontSize=13;" vertex="1" parent="1"><mxGeometry x="303.6" y="566.0" width="232.0" height="92.0" as="geometry"/></mxCell>
<mxCell id="cmd2" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#1a73e8&quot;&gt;&lt;b&gt;3  Domain&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;Repository validates command,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;Registry picks the adapter&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=2;fontColor=#202124;fontSize=13;" vertex="1" parent="1"><mxGeometry x="557.2" y="566.0" width="232.0" height="92.0" as="geometry"/></mxCell>
<mxCell id="cmd3" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#1a73e8&quot;&gt;&lt;b&gt;4  Adapter&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;MQTT: publish home/‹id›/set&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;HTTP: POST /devices/‹id›/set&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=2;fontColor=#202124;fontSize=13;" vertex="1" parent="1"><mxGeometry x="810.8" y="566.0" width="232.0" height="92.0" as="geometry"/></mxCell>
<mxCell id="cmd4" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#1a73e8&quot;&gt;&lt;b&gt;5  Transport&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;mqtt.js (WebSocket) or fetch&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;timeouts → typed AppError&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=2;fontColor=#202124;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1064.4" y="566.0" width="232.0" height="92.0" as="geometry"/></mxCell>
<mxCell id="cmd5" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#1a73e8&quot;&gt;&lt;b&gt;6  Device&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;Applies the change, then&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;reports the new state&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=2;fontColor=#202124;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1318.0" y="566.0" width="232.0" height="92.0" as="geometry"/></mxCell>
