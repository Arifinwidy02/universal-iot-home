<mxCell id="upd4" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#188038&quot;&gt;&lt;b&gt;5  State (Redux)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;dispatch(stateUpdated),&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;reducer updates the device&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#188038;strokeWidth=2;fontColor=#202124;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1064.4" y="716.0" width="232.0" height="92.0" as="geometry"/></mxCell>
