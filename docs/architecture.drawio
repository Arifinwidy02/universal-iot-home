<mxCell id="upd_head" value="&lt;font style=&quot;font-size:16px&quot; color=&quot;#188038&quot;&gt;&lt;b&gt;STATE UPDATE FLOW  ·  device changes → screen reflects it live&lt;/b&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;spacing=0;fontSize=13;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="50.0" y="680.0" width="1500.0" height="28.0" as="geometry"/></mxCell>
<mxCell id="upd0" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#188038&quot;&gt;&lt;b&gt;1  Device&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;State changes, e.g. someone&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;flips the plug on&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#188038;strokeWidth=2;fontColor=#202124;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50.0" y="716.0" width="232.0" height="92.0" as="geometry"/></mxCell>
<mxCell id="upd1" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#188038&quot;&gt;&lt;b&gt;2  Transport&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;MQTT: push on home/‹id›/state&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;HTTP: GET polled every N s&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#188038;strokeWidth=2;fontColor=#202124;fontSize=13;" vertex="1" parent="1"><mxGeometry x="303.6" y="716.0" width="232.0" height="92.0" as="geometry"/></mxCell>
<mxCell id="upd2" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#188038&quot;&gt;&lt;b&gt;3  Adapter&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;Parses JSON → DeviceState,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#202124&quot;&gt;maps failures to AppError&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#188038;strokeWidth=2;fontColor=#202124;fontSize=13;" vertex="1" parent="1"><mxGeometry x="557.2" y="716.0" width="232.0" height="92.0" as="geometry"/></mxCell>
